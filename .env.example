# =============================================================================
# SecureRAG - example environment
#
#   cp .env.example .env
#
# Every value below is a default that the application will use if the variable
# is absent, EXCEPT JWT_SECRET_KEY, which you must set for any deployment that
# outlives a single process.
#
# NEVER commit a filled-in .env. It is listed in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=SecureRAG
ENVIRONMENT=local                      # local | test | staging | production
DEBUG=false                            # true echoes exception detail in errors
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL + pgvector (what docker compose starts):
DATABASE_URL=postgresql+psycopg://securerag:securerag@localhost:5432/securerag
# Zero-infrastructure alternative for offline development and the test suite.
# Embeddings are stored as JSON and similarity is computed in Python: correct,
# but O(n) per query. Do not use it for a real corpus.
#   DATABASE_URL=sqlite:///./securerag_dev.db
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# REQUIRED in any real deployment. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random key is generated per process, which invalidates every
# issued token on restart.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOW_REGISTRATION=true                # set false once your accounts exist
PASSWORD_MIN_LENGTH=10
BCRYPT_ROUNDS=12                       # raise for stronger hashing, costs CPU

# -----------------------------------------------------------------------------
# LLM provider
# -----------------------------------------------------------------------------
# openai : any OpenAI-compatible /chat/completions endpoint
#          (OpenAI, Groq, Together, OpenRouter, vLLM, LM Studio, ...)
# ollama : a local Ollama server -- no API key, no per-token cost
# echo   : deterministic offline stub used by tests and the credential-free
#          demo. It is NOT a language model; it extracts sentences from the
#          retrieved context. The app refuses to start in production with it.
LLM_PROVIDER=echo
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.0                    # 0 for reproducible, grounded answers
LLM_MAX_TOKENS=900
LLM_TIMEOUT_SECONDS=60

# --- Ollama example -----------------------------------------------------------
#   LLM_PROVIDER=ollama
#   LLM_MODEL=llama3.1:8b
#   LLM_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# Embedding provider
# -----------------------------------------------------------------------------
# hashing : dependency-free deterministic lexical embedder (default). Real
#           similarity, but lexical only -- it cannot match paraphrases.
#           Fine for tests and demos, not for production retrieval quality.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
# MUST match the model's output size, and MUST match the dimension the
# database column was migrated with. Changing it requires re-embedding.
#   text-embedding-3-small -> 1536 | nomic-embed-text (ollama) -> 768
#   hashing                -> anything; 384 is the default
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# Ingestion
# -----------------------------------------------------------------------------
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=20
ALLOWED_FILE_EXTENSIONS=pdf,txt,md,markdown,docx
CHUNK_TARGET_TOKENS=320                # target chunk size (approx. tokens)
CHUNK_OVERLAP_TOKENS=60                # carried between adjacent chunks
CHUNK_MIN_CHARS=120                    # shorter fragments are merged forward
MAX_CHUNKS_PER_DOCUMENT=5000

# -----------------------------------------------------------------------------
# Retrieval
# -----------------------------------------------------------------------------
RETRIEVAL_MODE=hybrid                  # vector | keyword | hybrid
RETRIEVAL_TOP_K=5                      # chunks placed in the final context
RETRIEVAL_CANDIDATE_K=20               # candidates fetched per arm before fusion
HYBRID_RRF_K=60                        # Reciprocal Rank Fusion constant
RERANKER=heuristic                     # none | heuristic | cross_encoder
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MIN_SIMILARITY=0.05                    # drop candidates below this score
MAX_CONTEXT_CHARS=12000                # hard cap on assembled context

# -----------------------------------------------------------------------------
# Input guardrails
# -----------------------------------------------------------------------------
MIN_QUERY_LENGTH=3
MAX_QUERY_LENGTH=2000
# Injection risk in [0,1]. >= BLOCK rejects the request; >= FLAG allows it but
# records a security event and marks the answer. Lowering BLOCK increases
# detection and false positives together -- measure with
# `python -m app.evaluation.run` (from backend/) before changing it.
INJECTION_BLOCK_THRESHOLD=0.75
INJECTION_FLAG_THRESHOLD=0.45
# Optional third detection layer: sends borderline inputs to the LLM as a
# classifier. Costs one extra call per borderline request; off by default.
INJECTION_USE_LLM_CLASSIFIER=false
DUPLICATE_QUERY_WINDOW_SECONDS=60
DUPLICATE_QUERY_LIMIT=5

# -----------------------------------------------------------------------------
# Indirect injection (retrieved-document) defence
# -----------------------------------------------------------------------------
CONTEXT_SANITISATION_ENABLED=true
CONTEXT_INJECTION_QUARANTINE_THRESHOLD=0.60   # chunk excluded from retrieval
CONTEXT_INJECTION_NEUTRALISE_THRESHOLD=0.35   # chunk kept, instructions defanged

# -----------------------------------------------------------------------------
# Output guardrails
# -----------------------------------------------------------------------------
GROUNDING_ENABLED=true
GROUNDING_MIN_SCORE=0.45
GROUNDING_MODE=block                   # block | warn
REQUIRE_CITATIONS=true
OUTPUT_SAFETY_ENABLED=true
# Shown to the user whenever an answer is withheld -- for an unanswerable
# question, a failed grounding check, or an empty retrieval. Deliberately the
# same text in all three cases: which guardrail fired is not the user's
# business, and varying it would leak the reason (see docs/security.md).
# INSUFFICIENT_EVIDENCE_MESSAGE=I could not find sufficient evidence in your documents to answer that reliably. Try rephrasing the question, or upload a document that covers it.

# -----------------------------------------------------------------------------
# PII
# -----------------------------------------------------------------------------
# off    : no scanning
# warn   : detect and record, return the answer unchanged
# redact : replace each match with [TYPE_REDACTED]  (default)
# block  : refuse to return an answer containing PII
PII_DETECTION_MODE=redact
PII_ENGINE=regex                       # regex | presidio (see requirements-optional.txt)
PII_ENTITIES=EMAIL,PHONE,CREDIT_CARD,AADHAAR,PAN,SSN,IP_ADDRESS,IBAN,API_KEY
PII_SCAN_INPUT=true

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# In-process fixed-window counters: correct for a single worker, approximate
# across replicas. See docs/security.md "Limitations".
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=5
RATE_LIMIT_AUTH_PER_MINUTE=10

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json                        # json | console
SECURITY_EVENT_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Global posture
# -----------------------------------------------------------------------------
# If a guardrail raises an unexpected exception, block the request instead of
# letting it through unchecked. Turn this off only for debugging.
FAIL_CLOSED=true

# -----------------------------------------------------------------------------
# Frontend (consumed by Vite at BUILD time -- Vite inlines VITE_* into the
# bundle, so changing this needs a rebuild, not a restart)
# -----------------------------------------------------------------------------
# Under docker compose, nginx proxies /api to the backend, so a relative path
# keeps the browser on a single origin and avoids CORS entirely.
VITE_API_BASE_URL=/api/v1
# Running the Vite dev server directly instead? Use the absolute URL:
#   VITE_API_BASE_URL=http://localhost:8000/api/v1

# -----------------------------------------------------------------------------
# docker compose only (ignored when running the backend directly)
# -----------------------------------------------------------------------------
POSTGRES_USER=securerag
POSTGRES_PASSWORD=securerag
POSTGRES_DB=securerag
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
